generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Guild {
  id               String   @id 
  welcomeChannelId String?      
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model User {
  id          String   @id 
  blacklisted Boolean  @default(false) 
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// NEW: The Moderation Audit Log
model Infraction {
  id          String   @id @default(uuid()) // Automatically generates a unique ID like "abc-123"
  guildId     String   // The server where it happened
  userId      String   // The person who broke the rule
  moderatorId String   // The staff member who issued the punishment
  type        String   // "WARN", "KICK", "BAN", "TIMEOUT"
  reason      String   // Why they were punished
  createdAt   DateTime @default(now())
}